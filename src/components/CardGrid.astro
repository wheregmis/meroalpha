---
// A list of Surface cards with a title and a body, two or three across.
import Surface from './Surface.astro';

// `level={2}` for cards straight under a page's h1; they look the same.
interface Props { items: { title: string; body: string; kicker?: string }[]; cols?: 2 | 3; ordered?: boolean; class?: string; level?: 2 | 3 }
const { items, cols = 2, ordered, class: cls, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const List = ordered ? 'ol' : 'ul';
---
<List class:list={['card-grid', `card-grid--${cols}`, cls]}>
  {items.map((item) => (
    <Surface as="li">
      {item.kicker && <p class="kicker"><b>{item.kicker}</b></p>}
      <Heading class:list={[level === 2 && 'as-h3']}>{item.title}</Heading>
      <p>{item.body}</p>
    </Surface>
  ))}
</List>
