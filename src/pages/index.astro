---
import Page from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import Surface from '../components/Surface.astro';
import Pill from '../components/Pill.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import Screenshot from '../components/Screenshot';
import Segmented from '../components/Segmented';
import Waitlist from '../components/Waitlist.astro';
import Updates from '../components/Updates.astro';
import Timeline from '../components/Timeline.astro';
import ScrollDemo from '../components/ScrollDemo.astro';
import '../styles/changelog.css';
import '../styles/landing.css';

const facts = ['Cites every page', 'Virtual NPR', '5-minute candles', 'No new entries after 14:30 NPT', 'Graded against NEPSE', 'Runs on your Mac', 'Works with Claude or Codex', 'No brokerage connected'];

const screens = [
  { id: 'stock', label: 'Stock page', image: '06-stock.jpg', caption: 'The price, your paper position and the agent’s plan. Information only: there are no buy or sell buttons.', alt: 'NABIL’s stock page on sample data: the last close, a three-month graph with the plan’s stop and target, and the paper position' },
  { id: 'chart', label: 'Advanced chart', image: '06-advanced-chart.jpg', caption: 'Candles, indicators and drawing tools, on MeroAlpha’s own chart engine.', alt: 'The advanced chart with daily candles, a 20-day moving average, volume and drawing tools' },
  { id: 'portfolio', label: 'Portfolio', image: '04-portfolio.jpg', caption: 'Your paper account at a glance: value, cash, the loss limit and what the agent did last.', alt: 'The portfolio on sample data after one session: total value with its change, invested and cash, the loss limit, and the agent’s last run' },
];

const day = [
  { title: 'After the close', body: 'It scans the watchlist and drafts plans: an entry ceiling, a fixed stop and target, and 1% of equity at risk.' },
  { title: 'Every five minutes', body: 'A plan triggers on a five-minute candle above the first 15 minutes’ high, until 14:30 NPT.' },
  { title: 'The fill', body: 'Orders fill only from fresh trade prints, with fees, slippage and a 10% participation cap.' },
  { title: 'Five sessions later', body: 'Each call is graded against the NEPSE index, and the report card keeps score.' },
];

// 24-pt outline icons in the style of the app's icons.tsx.
const data = [
  { title: 'Local by default', body: 'Captured pages, findings and the paper account live in your Library folder.', icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>' },
  { title: 'Sharing is optional', body: 'Signed in, it shares verified findings with their page’s address and hash, never the page.', icon: '<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/>' },
  { title: 'Your own agent', body: 'Connect your own Claude or Codex, signed in with its own command-line tool.', icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3"/>' },
];
---
<Page title="MeroAlpha: a NEPSE analyst that trades on paper"
      description="A macOS app where an AI agent researches the Nepal stock market in a browser you can watch and runs a paper account in virtual NPR.">
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__text">
        <Pill>NEPSE · paper trading · private testing</Pill>
        <h1 id="hero-title">A NEPSE analyst that <em>trades on paper</em></h1>
        <p class="lead">It researches in a browser you can watch, and cites every page.</p>
        <div class="actions">
          <PrimaryButton href="/waitlist" glow>Join the waitlist <span aria-hidden="true">→</span></PrimaryButton>
          <SecondaryButton href="#demo">See it work</SecondaryButton>
        </div>
        <p class="note">For Macs with Apple silicon, in private testing. Virtual NPR only; no brokerage is connected.</p>
      </div>
      <div class="hero__stage">
        <Screenshot name="07-ask.jpg" phone="07-ask-phone.jpg" className="shot--hero" priority
          alt="MeroAlpha on sample data: NABIL’s stock page beside the Ask panel, where the agent compares NABIL’s and NICA’s closes after opening two pages and cites both" />
        <p class="hud hud--a" aria-hidden="true"><span class="dot"></span>Researching in a live browser</p>
        <p class="hud hud--b" aria-hidden="true"><span class="hud__key">Sources</span>Every finding cites its page</p>
        <p class="hud hud--c" aria-hidden="true"><span class="hud__key">Risk</span>1% of equity per plan</p>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">{[...facts, ...facts].map((f) => <span>{f}</span>)}</div>
    </div>

    <Section id="demo" class="demo" num="01" label="Demo" title="Watch it work a trade, on paper">
      <p slot="intro" class="panel__caption">From a question to a report card. Scroll through an invented example: information only, virtual NPR, no brokerage connected.</p>
      <ScrollDemo />
    </Section>

    <Section id="tour" class="tour" num="02" label="Screens" title="Three screens, each with one job">
      <div data-reveal><Segmented client:visible label="Screens" tabs={screens} /></div>
    </Section>

    <Section id="day" class="day" num="03" label="The loop" title="How a trading day runs">
      <Timeline items={day.map((d, i) => ({ label: `Step ${i + 1}`, ...d }))} />
    </Section>

    <Section id="data" class="data" num="04" label="Privacy" title="Your research stays on your Mac">
      <p slot="intro" class="data__more"><a class="link" href="/privacy">Read the privacy policy</a></p>
      <dl class="data__list">
        {data.map((d) => (
          <Surface>
            <dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={d.icon} />{d.title}</dt>
            <dd>{d.body}</dd>
          </Surface>
        ))}
      </dl>
    </Section>

    <Section id="changelog" class="changelog" num="05" label="Changelog" title="What’s new">
      <Fragment slot="intro">
        <p class="lead">What MeroAlpha Agent does today, and what we are building next.</p>
        <SecondaryButton href="/changelog" small>Full changelog</SecondaryButton>
      </Fragment>
      <Updates limit={3} />
    </Section>

    <Section id="products" class="products" num="06" label="From MeroAlpha" title="What we make">
      <ul class="products__list">
        <Surface as="li">
          <p class="kicker"><span class="chip"><span class="dot"></span>Private testing</span></p>
          <h3>MeroAlpha Agent</h3>
          <p>The macOS app on this page: an AI analyst that researches NEPSE in a browser you can watch and trades a paper account.</p>
          <a class="link" href="/waitlist">Join the waitlist</a>
        </Surface>
        <Surface as="li">
          <p class="kicker"><span class="chip chip--quiet">Shelved</span></p>
          <h3>MeroAlpha Data Platform</h3>
          <p>A NEPSE market-data API and research lab we built and never launched, because no provider could license us the data.</p>
          <a class="link" href="/story">Read the story</a>
        </Surface>
      </ul>
    </Section>

    <section class="close container" aria-labelledby="close-title">
      <Surface class="close__card">
        <h2 id="close-title">Be first to let it trade on paper</h2>
        <p class="lead">MeroAlpha Agent is in private testing. Leave your email and we’ll write when there’s a build for you.</p>
        <Waitlist id="close-email" />
      </Surface>
    </section>
  </main>
</Page>
