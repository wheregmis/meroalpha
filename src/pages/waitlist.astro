---
import Page from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import Surface from '../components/Surface.astro';
import CardGrid from '../components/CardGrid.astro';
import Pill from '../components/Pill.astro';
import Waitlist from '../components/Waitlist.astro';
import '../styles/join.css';

const next = [
  { title: 'One email when a build is ready', body: 'No newsletter. We write when there is something for you to install, and that’s it.' },
  { title: 'Small groups first', body: 'Testers join in small groups, so we can read every report card and every bug.' },
  { title: 'Leave whenever you like', body: 'Reply to any email, or write to us, and we delete your address.' },
];
---
<Page title="Join the MeroAlpha waitlist" description="MeroAlpha Agent is in private testing. Leave your email and we’ll write when there’s a build for you." current="/waitlist">
  <main id="main">
    <Section id="join" class="join" level={1} title="MeroAlpha Agent is in private testing">
      <Fragment slot="intro">
        <Pill>Private testing · macOS · Apple silicon</Pill>
        <p class="lead">There are no public builds yet. Leave your email and we’ll write when there’s one for you to try. Until then, <a class="link" href="/#demo">watch it work a trade</a>.</p>
      </Fragment>
      <Surface class="join__card" still>
        <Waitlist id="join-email" />
        <p class="note">We keep only your address and the date you joined. See the <a class="link" href="/privacy#waitlist">privacy policy</a>.</p>
      </Surface>
      <CardGrid class="join__next" items={next} cols={3} ordered level={2} />
    </Section>

    <Section id="contact" class="join join--contact" label="Contact" title="Talk to us">
      <p slot="intro" class="lead">Questions, feedback, partnerships or a bug on this site? <a class="link" href="/contact">Send us a message</a>, or email <a class="link" href="mailto:get2sabin@gmail.com">get2sabin@gmail.com</a>.</p>
    </Section>
  </main>
</Page>
