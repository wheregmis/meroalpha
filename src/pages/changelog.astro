---
import Page from '../layouts/Page.astro';
import Section from '../components/Section.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import Releases from '../components/Releases.astro';
---
<Page title="Changelog: MeroAlpha" description="Every public release of MeroAlpha Agent, newest first." current="/changelog">
  <main id="main">
    <Section id="changelog" class="changelog changelog--page" label="Changelog" title="Every release, newest first">
      <Fragment slot="intro">
        <p class="lead">From the public releases on GitHub. Each version links to its downloads.</p>
        <SecondaryButton href="https://github.com/wheregmis/meroalpha/releases" small>Releases on GitHub</SecondaryButton>
      </Fragment>
      <Releases limit={10} />
    </Section>
  </main>
</Page>
